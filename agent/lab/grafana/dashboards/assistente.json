    {
      "id": 7,
      "type": "barchart",
      "title": "Chamadas por ferramenta",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "lab-pg"
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 0,
        "y": 13
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "lab-pg"
          },
          "rawQuery": true,
          "editorMode": "code",
          "format": "table",
          "rawSql": "select p->>'ferramenta' as ferramenta, count(*) as chamadas, count(*) filter (where not (p->>'ok')::boolean) as com_erro from obs.perguntas, jsonb_array_elements(registro->'passos') p where $__timeFilter(inicio) group by 1 order by 2 desc"
        }
      ],
      "options": {
        "orientation": "horizontal",
        "showValue": "auto"
      },
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      }
    },
