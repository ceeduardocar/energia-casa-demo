          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "lab-pg"
          },
          "rawQuery": true,
          "editorMode": "code",
          "format": "table",
          "rawSql": "select inicio, expert, pergunta, ms_total as ms, tokens_entrada + tokens_saida as tokens, verificados, sem_fonte, coalesce(erro, '') as erro from obs.perguntas where $__timeFilter(inicio) order by inicio desc limit 50"
