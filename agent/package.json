{
  "name": "energia-casa-assistente",
  "version": "0.1.0",
  "private": true,
  "description": "Assistente de energia da casa: agentes experts em LangChain.js, Gemini e RAG híbrido no Weaviate",
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "test": "node --test \"tests/**/*.test.ts\"",
    "ask": "node src/cli.ts",
    "ingest": "node src/rag/ingest-cli.ts",
    "eval": "node eval/run.ts",
    "eval:offline": "node eval/run.ts --offline",
    "report": "node src/obs/report-cli.ts",
    "obs:export": "node src/obs/pg-export-cli.ts"
  },
  "dependencies": {
    "@langchain/core": "1.3.5",
    "@langchain/google-genai": "2.3.5",
    "pg": "8.23.1",
    "weaviate-client": "3.15.3",
    "zod": "4.6.7"
  }
}
